# Build artifacts
/target/
/tools/no-outer-fneg-of-fma/target/
**/*.rs.bk
# the root Cargo.lock is tracked: the golden tests pin the arithmetic identifier
# of the resolved alice-det-math, so CI must build with the recorded versions
# (nested crates such as fuzz/ and scripts/gen_db_fixture/ keep theirs untracked)
Cargo.lock
!/Cargo.lock
# the G3 syntax-tree tool is built with --locked: its lock is tracked (identical in every carrier)
!/tools/no-outer-fneg-of-fma/Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# cargo-fuzz (fuzz/ is its own crate; root /target/ does not cover it)
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/Cargo.lock

# Python bytecode (scripts/docs_lint.py tests)
__pycache__/
